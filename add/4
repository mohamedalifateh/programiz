# Simple Shift Reduce Parser

stack = []
input_string = input("Enter input string (end with $): ")

# Example grammar: S -> aSb | ab
# Valid strings: ab, aabb, aaabbb...

def check_reduce():
    global stack
    # Reduce "ab" to S
    if len(stack) >= 2 and stack[-2:] == ['a', 'b']:
        stack = stack[:-2]
        stack.append('S')
        print("Reduce: ab -> S")

    # Reduce "aSb" to S
    if len(stack) >= 3 and stack[-3:] == ['a', 'S', 'b']:
        stack = stack[:-3]
        stack.append('S')
        print("Reduce: aSb -> S")


i = 0
while i < len(input_string):
    # Shift
    print("Shift:", input_string[i])
    stack.append(input_string[i])
    print("Stack:", stack)

    # Try reduce
    check_reduce()

    i += 1

# Final check
if stack == ['S', '$'] or stack == ['S']:
    print("String Accepted")
else:
    print("String Rejected")